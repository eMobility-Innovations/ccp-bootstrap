LoginRequired = kcd.LoginRequired
USER_AGENT = 'grafana-api/1 (+claude-code-policy)'
LOGIN_HINT = 'grafana-api login'


def _http(method, url, headers, body):
    return kcd.http(method, url, headers, body, USER_AGENT)


def _path():
    return Path(os.environ.get('GRAFANA_API_CONFIG_DIR', str(Path.home() / '.config/grafana-api'))) / 'credentials.json'


def _save(data):
    kcd.save_private(_path(), data)


def _read():
    return kcd.read_credentials(_path(), LOGIN_HINT)


def _kc(endpoint, fields):
    realm = os.environ.get('GRAFANA_API_KC_REALM_URL', 'https://auth.fiszu.com/realms/fiszu')
    client = os.environ.get('GRAFANA_API_CLIENT_ID', 'grafana-cli')
    return kcd.kc_post(lambda *a: _http(*a), realm, client, endpoint, fields)


def _error(data, status):
    return kcd.error_class(data, status)


def _store_token(token, previous=None):
    data = kcd.credentials_from(token, previous)
    _save(data)
    return data['access_token']


def _token():
    service = os.environ.get('GRAFANA_SERVICE_ACCOUNT_TOKEN')
    if service:
        return service
    data = _read()
    access = kcd.valid_access(data)
    if access:
        return access
    try:
        token = kcd.refresh(_kc, data, LOGIN_HINT)
    except LoginRequired:
        _path().unlink(missing_ok=True)
        raise
    return _store_token(token, data)


def _device():
    def announce(uri, code):
        print(uri + ' (code ' + code + ') — approve in your browser', file=sys.stderr, flush=True)
    return _store_token(kcd.device_flow(_kc, announce))


def _api(method, path, body=None, query=()):
    if not path.startswith('/') or path.startswith('//'):
        raise ValueError('path must be relative to Grafana')
    url = os.environ.get('GRAFANA_URL', 'https://grafana.fiszu.com').rstrip('/') + path
    if query:
        url += ('&' if '?' in url else '?') + urllib.parse.urlencode(query)
    token = _token()
    headers = {'Authorization': 'Bearer ' + token} if os.environ.get('GRAFANA_SERVICE_ACCOUNT_TOKEN') else {'X-JWT-Assertion': token}
    headers.update({'Accept': 'application/json'})
    if body is not None:
        headers['Content-Type'] = 'application/json'
    return _http(method, url, headers, body)


def _print_response(status, body):
    try:
        print(json.dumps(json.loads(body), indent=2, ensure_ascii=False))
    except (ValueError, UnicodeError):
        print(body.decode('utf-8', errors='replace'))
    if not 200 <= status < 300:
        print('grafana-api: HTTP ' + str(status), file=sys.stderr)
        return 1
    return 0


def _logout():
    if os.environ.get('GRAFANA_SERVICE_ACCOUNT_TOKEN'):
        return 0
    if not _path().exists():
        return 0
    try:
        ok, reason = kcd.revoke(_kc, _read()['refresh_token'])
        if not ok:
            print('grafana-api: revoke failed (' + reason + ')', file=sys.stderr)
    except (OSError, ValueError, KeyError) as exc:
        print('grafana-api: revoke failed (' + type(exc).__name__ + ')', file=sys.stderr)
    finally:
        _path().unlink(missing_ok=True)
    return 0


def _identity(login=False):
    status, body = _api('GET', '/api/user')
    if not 200 <= status < 300:
        return _print_response(status, body)
    user = json.loads(body)
    if login:
        url = os.environ.get('GRAFANA_URL', 'https://grafana.fiszu.com').rstrip('/')
        print('logged in to ' + url + ' as ' + user['login'])
        return 0
    for key in ('login', 'name', 'email', 'orgId'):
        print(str(key) + ': ' + str(user.get(key, '')))
    status, body = _api('GET', '/api/user/teams')
    if not 200 <= status < 300:
        return _print_response(status, body)
    print('teams: ' + ', '.join(team['name'] for team in json.loads(body)))
    return 0


def _request(args):
    method, path = ('GET', args.command) if args.command.startswith('/') else (args.command, args.path)
    if method not in ('GET', 'POST', 'PUT', 'PATCH', 'DELETE') or not path:
        raise ValueError('expected HTTP method and path')
    body = args.data
    if body is not None:
        body = Path(body[1:]).read_text(encoding='utf-8') if body.startswith('@') else body
        body = json.dumps(json.loads(body)).encode()
    query = []
    for value in args.query:
        key, separator, item = value.partition('=')
        if not separator:
            raise ValueError('query requires k=v')
        query.append((key, item))
    return _print_response(*_api(method, path, body, query))


def _parse(argv):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog='login — approve device login in your browser\nlogout — revoke and remove credentials\nwhoami — show user and teams\ntoken — print a valid access token\nGET|POST|PUT|PATCH|DELETE <path> — call the API\n/<path> — call the API with GET')
    parser.add_argument('command')
    parser.add_argument('path', nargs='?')
    parser.add_argument('--data')
    parser.add_argument('--query', nargs='+', action='extend', default=[])
    args = parser.parse_args(argv)
    return args


def _dispatch(args):
    if args.command == 'logout':
        return _logout()
    if args.command == 'login':
        if not os.environ.get('GRAFANA_SERVICE_ACCOUNT_TOKEN'):
            _device()
        return _identity(login=True)
    if args.command == 'whoami':
        return _identity()
    if args.command == 'token':
        print(_token())
        return 0
    return _request(args)


def main(argv=None):
    args = _parse(argv)
    try:
        return _dispatch(args)
    except LoginRequired as exc:
        print('grafana-api: ' + str(exc), file=sys.stderr)
        return 3
    except (OSError, ValueError, KeyError, TypeError) as exc:
        # A plain ValueError carries only this script's own fixed messages; anything else
        # (a subclass, OSError, ...) may quote a response, so it shows its class only.
        reason = str(exc) if type(exc) is ValueError else type(exc).__name__
        print('grafana-api: request failed (' + reason + ')', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
