def _profiles():
    local = Path(__file__).resolve().parent / 'profiles'
    if local.is_dir():
        return local
    return Path.home() / '.local/share/fiszu-connect/profiles'


def _profile():
    import hashlib
    raw = (_profiles() / 'connector-managed-settings.json').read_bytes()
    pin = json.loads((_profiles() / 'PINNED').read_text())
    profile = json.loads(raw)
    if (profile['profile_version'] != pin['profile_version'] or
            hashlib.sha256(raw).hexdigest() != pin['sha256']):
        raise ValueError('connector profile differs from PINNED')
    return profile, pin


