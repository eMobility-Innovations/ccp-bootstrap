LoginRequired = kcd.LoginRequired
USER_AGENT = 'fiszu-connect/1 (+claude-code-policy)'
LOGIN_HINT = 'fiszu-connect login'
SERVER_NAME = 'fiszu'
# Claude Code gives a headersHelper 10 s (code.claude.com/docs/en/mcp, "dynamic headers");
# one Keycloak round trip must fit inside that with room to print.
HEADERS_HTTP_TIMEOUT = 7
EXIT_LOGIN = 3


def _gateway():
    return os.environ.get('FISZU_CONNECT_URL', 'https://claude.fiszu.com/connectors/mcp')


def _http(method, url, headers, body):
    return kcd.http(method, url, headers, body, USER_AGENT, timeout=HEADERS_HTTP_TIMEOUT)


def _dir():
    return Path(os.environ.get('FISZU_CONNECT_CONFIG_DIR', str(Path.home() / '.config/fiszu-connect')))


def _path():
    return _dir() / 'credentials.json'


def _kc(endpoint, fields):
    realm = os.environ.get('FISZU_CONNECT_KC_REALM_URL', 'https://auth.fiszu.com/realms/fiszu')
    client = os.environ.get('FISZU_CONNECT_CLIENT_ID', 'ai-connectors-cli')
    return kcd.kc_post(lambda *a: _http(*a), realm, client, endpoint, fields)


@contextmanager
def _locked():
    """One refresher at a time. Every Claude Code session runs `headers` on connect, and two
    concurrent refreshes of one rotating refresh token would leave one of them refused."""
    _dir().mkdir(parents=True, exist_ok=True, mode=0o700)
    with open(_dir() / '.lock', 'a') as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle, fcntl.LOCK_UN)


def _store(token, previous=None):
    data = kcd.credentials_from(token, previous)
    kcd.save_private(_path(), data)
    return data['access_token']


def _token():
    data = kcd.read_credentials(_path(), LOGIN_HINT)
    access = kcd.valid_access(data)
    if access:
        return access
    with _locked():
        # Re-read under the lock: another session may have refreshed while we waited.
        data = kcd.read_credentials(_path(), LOGIN_HINT)
        access = kcd.valid_access(data)
        if access:
            return access
        try:
            token = kcd.refresh(_kc, data, LOGIN_HINT)
        except LoginRequired:
            _path().unlink(missing_ok=True)
            raise
        return _store(token, data)


def _claims(token):
    """The token's payload, for DISPLAY only — the gateway verifies the signature, not us."""
    import base64
    try:
        part = token.split('.')[1]
        return json.loads(base64.urlsafe_b64decode(part + '=' * (-len(part) % 4)))
    except (IndexError, ValueError):
        return {}


def _machine():
    """Attribution ("whence"), never authorization — the principal is the person."""
    return getpass.getuser() + '@' + socket.gethostname().split('.')[0]


def cmd_headers(_args):
    try:
        token = _token()
    except LoginRequired as exc:
        # Claude Code needs JSON on stdout even on failure; `/mcp` shows the server failing
        # and the hint below says why.
        print('{}')
        print('fiszu-connect: ' + str(exc), file=sys.stderr)
        return EXIT_LOGIN
    print(json.dumps({'Authorization': 'Bearer ' + token, 'X-Fiszu-Machine': _machine()}))
    return 0


def _person_present():
    """A human at a terminal: stdin is a tty AND /dev/tty opens (same test as the claude-mem
    sign-in). A device login nobody can approve waits ten minutes and then fails — so an
    installer's captured run, a hook or a CI job never starts one."""
    if not sys.stdin.isatty():
        return False
    try:
        open('/dev/tty', 'w').close()
    except OSError:
        return False
    return True


def cmd_login(args):
    if not getattr(args, 'force', False) and not _person_present():
        raise LoginRequired('no person at a terminal to approve the sign-in — run `' + LOGIN_HINT +
                            '` yourself (or `fiszu-connect login --force` to print the code anyway)')

    def announce(uri, code):
        print('fiszu-connect: approve this sign-in in your browser: ' + uri + ' (code ' + code + ')',
              file=sys.stderr, flush=True)
    access = _store(kcd.device_flow(_kc, announce))
    print('fiszu-connect: signed in as ' + str(_claims(access).get('preferred_username', '?')))
    return 0


def cmd_status(_args):
    try:
        token = _token()
    except LoginRequired as exc:
        print('fiszu-connect: ' + str(exc))
        return EXIT_LOGIN
    claims = _claims(token)
    left = int(float(kcd.read_credentials(_path(), LOGIN_HINT).get('exp', 0)) - time.time())
    print('fiszu-connect: signed in as ' + str(claims.get('preferred_username', '?')) +
          ' (' + str(claims.get('email', '')) + '); access token valid ' + str(max(left, 0)) +
          ' s, renewed silently; gateway ' + _gateway())
    return 0


def cmd_logout(_args):
    if not _path().exists():
        print('fiszu-connect: not signed in')
        return 0
    try:
        ok, reason = kcd.revoke(_kc, kcd.read_credentials(_path(), LOGIN_HINT)['refresh_token'])
        if not ok:
            print('fiszu-connect: revoke failed (' + reason + '); local sign-in removed anyway', file=sys.stderr)
    except (OSError, ValueError, KeyError) as exc:
        print('fiszu-connect: revoke failed (' + type(exc).__name__ + '); local sign-in removed anyway',
              file=sys.stderr)
    finally:
        _path().unlink(missing_ok=True)
    print('fiszu-connect: signed out')
    return 0


def mcp_definition(helper):
    return {'type': 'http', 'url': _gateway(),
            'headersHelper': shlex.quote(str(helper)) + ' headers'}


def cmd_install(_args):
    """Standalone path (no CCP): register `fiszu` for this user, then sign in if needed."""
    claude = shutil.which('claude')
    if not claude:
        print('fiszu-connect: `claude` is not on PATH — install Claude Code first', file=sys.stderr)
        return 1
    helper = Path(sys.argv[0]).resolve() if Path(sys.argv[0]).exists() else Path(__file__).resolve()
    subprocess.run([claude, 'mcp', 'remove', '--scope', 'user', SERVER_NAME],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    done = subprocess.run([claude, 'mcp', 'add-json', '--scope', 'user', SERVER_NAME,
                           json.dumps(mcp_definition(helper))], check=False)
    if done.returncode != 0:
        print('fiszu-connect: `claude mcp add-json` failed (exit ' + str(done.returncode) + ')', file=sys.stderr)
        return 1
    print('fiszu-connect: MCP server `' + SERVER_NAME + '` registered for this user')
    try:
        _token()
        return cmd_status(_args)
    except LoginRequired:
        return cmd_login(_args)


COMMANDS = {'headers': cmd_headers, 'login': cmd_login, 'status': cmd_status,
            'logout': cmd_logout, 'install': cmd_install}


def main(argv=None):
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog='login — sign in with your company account (browser approval)\n'
               'status — who you are signed in as\n'
               'headers — print the MCP auth headers (Claude Code runs this for you)\n'
               'logout — revoke and remove your sign-in\n'
               'install — without CCP: register the `fiszu` MCP server and sign in\n'
               'exit 3 = not signed in (run: fiszu-connect login)')
    parser.add_argument('command', choices=sorted(COMMANDS))
    parser.add_argument('--force', action='store_true',
                        help='login: start the device sign-in even without a terminal (prints the code)')
    args = parser.parse_args(argv)
    try:
        return COMMANDS[args.command](args)
    except LoginRequired as exc:
        print('fiszu-connect: ' + str(exc), file=sys.stderr)
        return EXIT_LOGIN
    except (OSError, ValueError, KeyError, TypeError) as exc:
        # A plain ValueError carries only this tool's own fixed messages; anything else may
        # quote a response, so it shows its class only.
        reason = str(exc) if type(exc) is ValueError else type(exc).__name__
        if args.command == 'headers':
            print('{}')
        print('fiszu-connect: ' + args.command + ' failed (' + reason + ')', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
